{
  "manifest_version": 3,
  "name": "DSH Browser Bridge",
  "version": "1.1.0",
  "description": "Lets DeepSeek Harness drive the browser you already have open (localhost relay).",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "debugger", "alarms", "storage", "offscreen"],
  "host_permissions": ["http://127.0.0.1:9311/*"],
  "background": { "service_worker": "background.js" }
}
